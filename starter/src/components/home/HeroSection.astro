---
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import { FileText, GitFork, Layers, CheckCircle2, BarChart3, Sparkles } from "@lucide/astro";

const answerOptions = [
  "Choosing our first CRM",
  "Replacing a CRM we do not like",
  "Improving tracking and reporting",
  "Comparing a few CRM options",
];

const recommendationReasons = [
  "Prioritize attribution-ready forms",
  "Keep implementation complexity moderate",
  "Compare CRM fit before vendor calls",
];
---

<section class="relative z-20 site-container pt-16 md:pt-24 lg:pt-32">
  <div class="grid items-center gap-12 lg:grid-cols-[1.02fr_0.98fr]">
    <div>
      <div class="mb-6 flex flex-wrap gap-2">
        <Badge variant="primary">CRM Decision Guide</Badge>
        <Badge variant="accent">Structured software selection</Badge>
      </div>

      <h1 class="mb-5 max-w-3xl text-4xl leading-tight md:text-5xl lg:text-6xl font-brand">
        Choose software with confidence.
      </h1>

      <p class="mb-7 max-w-2xl text-base md:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed">
        Take a quick CRM quiz and get a clearer recommendation path.
      </p>

      <div class="flex flex-wrap gap-3">
        <Button url="/crm-decision-guide" type="fill">
          <FileText size={16} /> Start CRM Guide
        </Button>
        <Button url="/crm-decision-guide">
          <Layers size={16} /> See how it works
        </Button>
        <Button url="/articles" type="outline" target="_self">
          <GitFork size={16} /> Read CRM articles
        </Button>
      </div>
    </div>

    <div class="relative">
      <BrowserFrame url="softwaredecisionguide.com">
        <div class="min-h-[360px] p-5 md:p-6">
          <div class="mb-6 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="grid h-10 w-10 place-items-center rounded-xl bg-primary/10 text-primary">
                <Sparkles class="h-5 w-5" />
              </div>
              <div>
                <p class="text-sm font-semibold text-neutral-800 dark:text-neutral-100">
                  CRM Decision Guide
                </p>
                <p class="text-xs text-neutral-500 dark:text-neutral-400">
                  5 questions. Clear recommendation path.
                </p>
              </div>
            </div>

            <span class="rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-[10px] font-semibold uppercase tracking-wide text-primary dark:bg-primary/10">
              Live MVP
            </span>
          </div>

          <div class="rounded-xl border border-primary/15 bg-bg-primary/70 p-4 dark:border-neutral-700 dark:bg-neutral-900/50">
            <div class="mb-4 flex items-center justify-between text-xs text-neutral-500 dark:text-neutral-400">
              <span>Question 3 of 5</span>
              <span>60%</span>
            </div>

            <div class="mb-5 h-2 rounded-full bg-primary/10">
              <div class="h-2 w-[60%] rounded-full bg-primary"></div>
            </div>

            <p class="mb-4 text-base font-semibold text-primary">
              What matters most in your CRM decision?
            </p>

            <div class="grid gap-2">
              {answerOptions.map((option, index) => (
                <div
                  class:list={[
                    "rounded-lg border px-3 py-2 text-sm transition",
                    index === 2
                      ? "border-primary bg-primary/10 text-primary dark:bg-primary/15 dark:text-primary-light"
                      : "border-primary/15 bg-bg-secondary/60 text-neutral-700 dark:border-neutral-700 dark:bg-neutral-800/60 dark:text-neutral-200"
                  ]}
                >
                  {option}
                </div>
              ))}
            </div>
          </div>

          <div class="mt-4 grid gap-3 md:grid-cols-[1fr_0.9fr]">
            <div class="rounded-xl border border-primary/15 bg-bg-secondary/60 p-4 dark:border-neutral-700 dark:bg-neutral-900/40">
              <div class="mb-3 flex items-center gap-2">
                <BarChart3 class="h-4 w-4 text-primary" />
                <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
                  Current direction
                </p>
              </div>

              <p class="mb-2 text-lg font-brand text-primary">
                Marketing attribution CRM
              </p>

              <p class="text-xs leading-relaxed text-neutral-600 dark:text-neutral-300">
                Your answers suggest the CRM shortlist should weight tracking, forms, lifecycle stages, and reporting fit.
              </p>
            </div>

            <div class="rounded-xl border border-primary/15 bg-bg-secondary/60 p-4 dark:border-neutral-700 dark:bg-neutral-900/40">
              <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
                Why this path
              </p>

              <div class="grid gap-2">
                {recommendationReasons.map((reason) => (
                  <div class="flex items-start gap-2 text-xs text-neutral-600 dark:text-neutral-300">
                    <CheckCircle2 class="mt-0.5 h-3.5 w-3.5 shrink-0 text-primary" />
                    <span>{reason}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </BrowserFrame>
    </div>
  </div>
</section>