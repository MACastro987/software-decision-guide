---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="CRM Decision Guide | Software Decision Guide">
  <main class="site-container py-28">
    <section class="mx-auto max-w-3xl">
      <p class="mb-4 text-sm font-semibold uppercase tracking-wide text-primary">
        CRM Decision Guide
      </p>

      <h1 class="mb-5 text-5xl font-brand text-primary">
        Find your CRM direction.
      </h1>

      <p class="mb-10 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-300">
        Answer five quick questions and get a clearer CRM recommendation path based on your priorities.
      </p>

      <div class="rounded-2xl border border-primary/15 bg-bg-secondary/70 p-6 shadow-sm">
        <div class="mb-6">
          <div class="mb-2 flex items-center justify-between text-sm text-neutral-500 dark:text-neutral-400">
            <span id="stepLabel">Question 1 of 5</span>
            <span id="progressPercent">20%</span>
          </div>

          <div class="h-2 rounded-full bg-primary/10">
            <div id="progressBar" class="h-2 rounded-full bg-primary transition-all" style="width: 20%;"></div>
          </div>
        </div>

        <div id="quizPanel">
          <h2 id="questionText" class="mb-6 text-2xl font-semibold text-neutral-800 dark:text-neutral-100">
          </h2>

          <div id="answerList" class="grid gap-3"></div>

          <p id="rewardText" class="mt-5 min-h-6 text-sm text-primary"></p>
        </div>

        <div id="resultPanel" class="hidden">
          <div id="recommendationReport">
            <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-primary">
              Your CRM direction
            </p>

            <h2 id="resultTitle" class="mb-4 text-3xl font-brand text-primary"></h2>

            <p id="resultDescription" class="mb-6 text-lg leading-relaxed text-neutral-600 dark:text-neutral-300"></p>

            <div class="mb-5 rounded-xl border border-primary/15 bg-bg-primary/50 p-4">
              <p class="mb-3 text-sm font-semibold text-neutral-800 dark:text-neutral-100">
                Why this direction fits
              </p>

              <div id="answerSummaryList" class="grid gap-3"></div>
            </div>

            <div class="rounded-xl border border-primary/15 bg-bg-primary/50 p-4">
              <p class="mb-3 text-sm font-semibold text-neutral-800 dark:text-neutral-100">
                Recommended next steps
              </p>

              <ul id="nextStepList" class="grid gap-2 text-sm text-neutral-600 dark:text-neutral-300"></ul>

              <p class="mt-4 text-xs text-neutral-500 dark:text-neutral-400">
                Affiliate links or sponsored options may appear in the future and will be clearly labeled.
              </p>
            </div>

            <p id="printFooter" class="mt-6 hidden text-xs text-neutral-500">
              Generated by Software Decision Guide at softwaredecisionguide.com.
            </p>
          </div>

          <div id="downloadActions" class="mt-5 grid gap-3 sm:grid-cols-2">
            <a
              href="/articles/"
              class="rounded-xl border border-primary/20 px-4 py-3 text-center font-medium text-neutral-700 transition hover:border-primary hover:bg-primary/5 dark:text-neutral-200"
            >
              View related CRM research
            </a>

            <button
              id="downloadPdfButton"
              class="rounded-xl bg-primary px-4 py-3 font-medium text-white transition hover:opacity-90"
            >
              Download recommendation PDF
            </button>
          </div>

          <p class="mt-3 text-xs text-neutral-500 dark:text-neutral-400">
            The download button opens your browser print dialog. Choose “Save as PDF” to keep a copy.
          </p>

          <button id="restartButton" class="mt-6 rounded-xl border border-primary/20 px-4 py-3 text-neutral-700 dark:text-neutral-200">
            Retake guide
          </button>
        </div>
      </div>
    </section>
  </main>

  <style is:global>
    @media print {
      @page {
        margin: 0.35in;
      }

      body {
        background: #ffffff !important;
        color: #111111 !important;
      }

      body * {
        visibility: hidden !important;
      }

      #recommendationReport,
      #recommendationReport * {
        visibility: visible !important;
      }

      #recommendationReport {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        border: 0 !important;
        box-shadow: none !important;
        background: #ffffff !important;
        color: #111111 !important;
        padding: 0 !important;
      }

      #recommendationReport * {
        background: transparent !important;
        color: #111111 !important;
      }

      #recommendationReport {
        font-size: 12px !important;
        line-height: 1.35 !important;
      }

      #recommendationReport h2 {
        font-size: 26px !important;
        margin-bottom: 12px !important;
      }

      #recommendationReport p {
        margin-bottom: 8px !important;
      }

      #answerSummaryList {
        gap: 6px !important;
      }

      #answerSummaryList > div {
        padding: 8px !important;
        break-inside: avoid !important;
      }

      #nextStepList {
        gap: 4px !important;
      }

      #nextStepList li {
        line-height: 1.3 !important;
        break-inside: avoid !important;
      }

      #downloadActions,
      #restartButton {
        display: none !important;
      }

      #printFooter {
        display: block !important;
        visibility: visible !important;
      }
    }
  </style>

  <script is:inline>
    const questions = [
      {
        text: "What kind of CRM decision are you making?",
        answers: [
          { label: "Choosing our first CRM", result: "simple", reward: "Good — we’ll prioritize clarity and adoption." },
          { label: "Replacing a CRM we do not like", result: "salesOps", reward: "Got it — we’ll focus on what needs to improve." },
          { label: "Choosing between a few CRMs", result: "compare", reward: "Good — we’ll make the tradeoffs easier to explain." },
          { label: "Improving tracking and reporting", result: "attribution", reward: "Great — measurement needs will shape the recommendation." }
        ]
      },
      {
        text: "What matters most right now?",
        answers: [
          { label: "Speed of implementation", result: "simple", reward: "Speed matters — we’ll favor faster launch paths." },
          { label: "Lowest cost", result: "simple", reward: "Budget matters — we’ll keep complexity low." },
          { label: "Ease of use", result: "simple", reward: "Adoption matters — simplicity gets more weight." },
          { label: "Reporting and attribution", result: "attribution", reward: "Reporting matters — we’ll weight analytics fit higher." }
        ]
      },
      {
        text: "What are you trying to fix first?",
        answers: [
          { label: "Leads falling through the cracks", result: "salesOps", reward: "Pipeline control is a key signal." },
          { label: "Sales follow-up is inconsistent", result: "salesOps", reward: "Follow-up discipline matters here." },
          { label: "Marketing and sales are disconnected", result: "allInOne", reward: "All-in-one tools may become more relevant." },
          { label: "We cannot see what is working", result: "attribution", reward: "Visibility and source tracking need priority." }
        ]
      },
      {
        text: "How much setup complexity can your team handle?",
        answers: [
          { label: "Almost none", result: "simple", reward: "Simple setup gets more weight." },
          { label: "Some setup is fine", result: "allInOne", reward: "A balanced platform may fit." },
          { label: "We have an admin or technical person", result: "salesOps", reward: "More configuration may be reasonable." },
          { label: "We need deep customization", result: "custom", reward: "Customization is now a major factor." }
        ]
      },
      {
        text: "How important is marketing attribution?",
        answers: [
          { label: "Not important yet", result: "simple", reward: "Good — we won’t overbuild the first CRM path." },
          { label: "Somewhat important", result: "allInOne", reward: "Basic source tracking should be considered." },
          { label: "Very important", result: "attribution", reward: "Attribution should shape the CRM shortlist." },
          { label: "Critical to revenue reporting", result: "attribution", reward: "Closed-loop reporting becomes a core requirement." }
        ]
      }
    ];

    const results = {
      simple: {
        title: "Low-friction CRM path",
        description: "Your answers point toward a CRM that should be simple to launch, easy for the team to adopt, and useful without a heavy admin layer. The priority is not maximum flexibility yet. The priority is getting clean contact records, basic pipeline visibility, and consistent follow-up in place.",
        nextSteps: [
          "Shortlist CRMs that can be implemented quickly without a dedicated administrator.",
          "Compare the basics first: contacts, pipeline stages, reminders, email logging, and simple reporting.",
          "Avoid paying for advanced automation or complex customization until the team is consistently using the CRM."
        ]
      },
      allInOne: {
        title: "All-in-one growth platform",
        description: "Your answers suggest that the CRM should not live by itself. You likely need a platform that can connect forms, email, marketing activity, sales follow-up, automation, and reporting in one system so fewer handoffs break between marketing and sales.",
        nextSteps: [
          "Compare platforms that combine CRM, forms, email, automation, and reporting.",
          "Map the lead path from form submission to sales follow-up before choosing a tool.",
          "Favor tools that reduce disconnected systems without becoming too complex for the team to manage."
        ]
      },
      salesOps: {
        title: "Sales operations CRM",
        description: "Your answers point toward a CRM decision driven by process control. The tool needs to help the team see pipeline movement, assign ownership, standardize follow-up, and give managers enough visibility to improve sales execution.",
        nextSteps: [
          "Define pipeline stages, ownership rules, and follow-up expectations before comparing vendors.",
          "Prioritize workflow automation, task management, deal visibility, and manager reporting.",
          "Avoid tools that are easy to start but weak once multiple people need to follow the same sales process."
        ]
      },
      attribution: {
        title: "Attribution-first CRM path",
        description: "Your answers suggest that measurement should be part of the CRM decision from the beginning. The CRM needs to support source tracking, forms, hidden fields, lifecycle stages, UTMs, and reporting that can connect marketing activity to qualified leads and revenue.",
        nextSteps: [
          "Require support for forms, hidden fields, UTMs, source tracking, and lifecycle stages.",
          "Plan how CRM data will connect to GA4, ad platforms, and sales outcomes.",
          "Avoid choosing a CRM that looks easy now but makes attribution and revenue reporting difficult later."
        ]
      },
      custom: {
        title: "Customizable scale CRM",
        description: "Your answers point toward a CRM that can adapt to more complex operations. Flexibility, custom fields, integrations, permissions, automation, and reporting depth matter more than the fastest possible launch.",
        nextSteps: [
          "Document custom fields, objects, integrations, permissions, and reporting needs before demos.",
          "Evaluate admin experience, automation depth, API and integration options, and long-term maintainability.",
          "Expect more setup work in exchange for a better long-term operating system."
        ]
      },
      compare: {
        title: "Structured comparison path",
        description: "Your answers suggest that you are not ready for a single generic recommendation. You need a structured comparison that makes the tradeoffs clear across cost, speed, adoption, reporting, and long-term flexibility.",
        nextSteps: [
          "Create a weighted scorecard before looking at pricing pages or booking demos.",
          "Compare each CRM against the same criteria: cost, speed, adoption, reporting, and flexibility.",
          "Use the scorecard to explain the decision internally instead of choosing based on brand familiarity alone."
        ]
      }
    };

    let currentQuestion = 0;
    let scores = {};
    let selectedAnswers = [];

    const questionText = document.getElementById("questionText");
    const answerList = document.getElementById("answerList");
    const rewardText = document.getElementById("rewardText");
    const stepLabel = document.getElementById("stepLabel");
    const progressPercent = document.getElementById("progressPercent");
    const progressBar = document.getElementById("progressBar");
    const quizPanel = document.getElementById("quizPanel");
    const resultPanel = document.getElementById("resultPanel");
    const resultTitle = document.getElementById("resultTitle");
    const resultDescription = document.getElementById("resultDescription");
    const answerSummaryList = document.getElementById("answerSummaryList");
    const nextStepList = document.getElementById("nextStepList");
    const downloadPdfButton = document.getElementById("downloadPdfButton");
    const restartButton = document.getElementById("restartButton");

    function renderQuestion() {
      const question = questions[currentQuestion];
      const percent = Math.round(((currentQuestion + 1) / questions.length) * 100);

      questionText.textContent = question.text;
      stepLabel.textContent = `Question ${currentQuestion + 1} of ${questions.length}`;
      progressPercent.textContent = `${percent}%`;
      progressBar.style.width = `${percent}%`;
      rewardText.textContent = "";
      answerList.innerHTML = "";

      question.answers.forEach((answer) => {
        const button = document.createElement("button");
        button.className = "rounded-xl border border-primary/20 px-4 py-4 text-left text-neutral-700 transition hover:border-primary hover:bg-primary/5 dark:text-neutral-200";
        button.textContent = answer.label;

        button.addEventListener("click", () => {
          scores[answer.result] = (scores[answer.result] || 0) + 1;
          selectedAnswers.push({
            question: question.text,
            answer: answer.label
          });

          rewardText.textContent = answer.reward;

          setTimeout(() => {
            currentQuestion += 1;

            if (currentQuestion < questions.length) {
              renderQuestion();
            } else {
              renderResult();
            }
          }, 450);
        });

        answerList.appendChild(button);
      });
    }

    function renderAnswerSummary() {
      answerSummaryList.innerHTML = "";

      selectedAnswers.forEach((selectedAnswer, index) => {
        const item = document.createElement("div");
        item.className = "rounded-lg border border-primary/10 bg-bg-secondary/40 p-3";

        const label = document.createElement("p");
        label.className = "mb-1 text-xs font-semibold uppercase tracking-wide text-primary";
        label.textContent = `Question ${index + 1}`;

        const question = document.createElement("p");
        question.className = "text-sm font-medium text-neutral-800 dark:text-neutral-100";
        question.textContent = selectedAnswer.question;

        const answer = document.createElement("p");
        answer.className = "mt-1 text-sm text-neutral-600 dark:text-neutral-300";
        answer.textContent = selectedAnswer.answer;

        item.appendChild(label);
        item.appendChild(question);
        item.appendChild(answer);

        answerSummaryList.appendChild(item);
      });
    }

    function renderNextSteps(result) {
      nextStepList.innerHTML = "";

      result.nextSteps.forEach((step) => {
        const item = document.createElement("li");
        item.className = "flex gap-2";

        const marker = document.createElement("span");
        marker.className = "text-primary";
        marker.textContent = "•";

        const text = document.createElement("span");
        text.textContent = step;

        item.appendChild(marker);
        item.appendChild(text);

        nextStepList.appendChild(item);
      });
    }

    function renderResult() {
      const winningKey = Object.keys(scores).sort((a, b) => scores[b] - scores[a])[0] || "simple";
      const result = results[winningKey];

      quizPanel.classList.add("hidden");
      resultPanel.classList.remove("hidden");
      stepLabel.textContent = "Complete";
      progressPercent.textContent = "100%";
      progressBar.style.width = "100%";
      resultTitle.textContent = result.title;
      resultDescription.textContent = result.description;

      renderAnswerSummary();
      renderNextSteps(result);
    }

    downloadPdfButton.addEventListener("click", () => {
      window.print();
    });

    restartButton.addEventListener("click", () => {
      currentQuestion = 0;
      scores = {};
      selectedAnswers = {};
      selectedAnswers = [];
      answerSummaryList.innerHTML = "";
      nextStepList.innerHTML = "";
      resultPanel.classList.add("hidden");
      quizPanel.classList.remove("hidden");
      renderQuestion();
    });

    renderQuestion();
  </script>
</Layout>