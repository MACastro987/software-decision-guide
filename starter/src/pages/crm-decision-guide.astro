---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="CRM Decision Guide | Software Decision Guide">
  <main class="site-container py-32">
    <p class="mb-4 text-sm font-semibold uppercase tracking-wide text-primary">
      CRM Decision Guide
    </p>

    <h1 class="mb-6 max-w-3xl text-5xl font-brand text-primary">
      Find your CRM direction.
    </h1>

    <p class="max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-300">
      Answer a few structured questions about your team, budget, sales process, reporting needs, and implementation priorities.
    </p>

    <section class="mt-12 max-w-2xl rounded-2xl border border-primary/15 bg-bg-secondary/60 p-6">
      <p class="mb-2 text-sm font-semibold text-primary">
        Quiz MVP coming next
      </p>

      <h2 class="mb-4 text-2xl font-semibold text-neutral-800 dark:text-neutral-100">
        What matters most in your CRM decision?
      </h2>

      <div class="grid gap-3">
        <button class="rounded-xl border border-primary/20 px-4 py-3 text-left text-neutral-700 dark:text-neutral-200">
          Speed of implementation
        </button>
        <button class="rounded-xl border border-primary/20 px-4 py-3 text-left text-neutral-700 dark:text-neutral-200">
          Lowest cost
        </button>
        <button class="rounded-xl border border-primary/20 px-4 py-3 text-left text-neutral-700 dark:text-neutral-200">
          Ease of use
        </button>
        <button class="rounded-xl border border-primary/20 px-4 py-3 text-left text-neutral-700 dark:text-neutral-200">
          Reporting and attribution
        </button>
      </div>
    </section>
  </main>
</Layout>