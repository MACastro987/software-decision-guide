---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="CRM Decision Guide | Software Decision Guide">
  <main class="site-container py-28">
    <section class="mx-auto max-w-3xl">
      <p class="mb-4 text-sm font-semibold uppercase tracking-wide text-primary">
        CRM Decision Guide
      </p>

      <h1 class="mb-5 text-5xl font-brand text-primary">
        Find the right CRM for your team.
      </h1>

      <p class="mb-4 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-300">
        Answer five questions to compare HubSpot, Pipedrive, Zoho CRM, and ClickUp.
        You’ll get one recommendation, who it fits best, when to avoid it, and the
        strongest alternative.
      </p>

      <p class="mb-10 max-w-2xl text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
        Recommendations are based on your answers. Affiliate relationships do not
        determine which product is recommended.
      </p>

      <div class="rounded-2xl border border-primary/15 bg-bg-secondary/70 p-6 shadow-sm">
        <div class="mb-6">
          <div class="mb-2 flex items-center justify-between text-sm text-neutral-500 dark:text-neutral-400">
            <span id="stepLabel">Question 1 of 5</span>
            <span id="progressPercent">20%</span>
          </div>

          <div class="h-2 rounded-full bg-primary/10">
            <div
              id="progressBar"
              class="h-2 rounded-full bg-primary transition-all"
              style="width: 20%;"
            ></div>
          </div>
        </div>

        <div id="quizPanel">
          <h2
            id="questionText"
            class="mb-6 text-2xl font-semibold text-neutral-800 dark:text-neutral-100"
          >
          </h2>

          <div id="answerList" class="grid gap-3"></div>

          <p
            id="rewardText"
            class="mt-5 min-h-6 text-sm text-primary"
            aria-live="polite"
          ></p>
        </div>

        <div id="resultPanel" class="hidden" tabindex="-1">
          <div id="recommendationReport">
            <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-primary">
              Your CRM recommendation
            </p>

            <h2 id="resultTitle" class="mb-3 text-3xl font-brand text-primary"></h2>

            <p
              id="resultDescription"
              class="mb-5 text-lg leading-relaxed text-neutral-600 dark:text-neutral-300"
            ></p>

            <div class="mb-5 grid gap-3 sm:grid-cols-2">
              <div class="rounded-xl border border-primary/15 bg-bg-primary/50 p-4">
                <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-primary">
                  Best for
                </p>
                <p
                  id="resultBestFor"
                  class="text-sm text-neutral-700 dark:text-neutral-200"
                ></p>
              </div>

              <div class="rounded-xl border border-primary/15 bg-bg-primary/50 p-4">
                <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-primary">
                  Avoid if
                </p>
                <p
                  id="resultAvoidIf"
                  class="text-sm text-neutral-700 dark:text-neutral-200"
                ></p>
              </div>
            </div>

            <div class="mb-5 rounded-xl border border-primary/15 bg-bg-primary/50 p-4">
              <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-primary">
                Best alternative
              </p>
              <p
                id="resultAlternative"
                class="text-sm text-neutral-700 dark:text-neutral-200"
              ></p>
            </div>

            <a
              id="resultCta"
              href="#"
              target="_blank"
              rel="noopener"
              class="mb-6 inline-flex rounded-xl bg-primary px-5 py-3 font-medium text-white transition hover:opacity-90"
            >
              Visit recommended CRM
            </a>

            <div class="mb-5 rounded-xl border border-primary/15 bg-bg-primary/50 p-4">
              <p class="mb-3 text-sm font-semibold text-neutral-800 dark:text-neutral-100">
                Why this recommendation fits
              </p>

              <div id="answerSummaryList" class="grid gap-3"></div>
            </div>

            <div class="rounded-xl border border-primary/15 bg-bg-primary/50 p-4">
              <p class="mb-3 text-sm font-semibold text-neutral-800 dark:text-neutral-100">
                Recommended next steps
              </p>

              <ul
                id="nextStepList"
                class="grid gap-2 text-sm text-neutral-600 dark:text-neutral-300"
              ></ul>

              <p class="mt-4 text-xs text-neutral-500 dark:text-neutral-400">
                Software Decision Guide may earn a commission from some links.
                Affiliate relationships do not determine our recommendations.
              </p>
            </div>

            <p id="printFooter" class="mt-6 hidden text-xs text-neutral-500">
              Generated by Software Decision Guide at softwaredecisionguide.com.
            </p>
          </div>

          <div id="downloadActions" class="mt-5 grid gap-3 sm:grid-cols-2">
            <a
              href="/articles/"
              class="rounded-xl border border-primary/20 px-4 py-3 text-center font-medium text-neutral-700 transition hover:border-primary hover:bg-primary/5 dark:text-neutral-200"
            >
              View related CRM research
            </a>

            <button
              id="downloadPdfButton"
              type="button"
              class="rounded-xl bg-primary px-4 py-3 font-medium text-white transition hover:opacity-90"
            >
              Download recommendation PDF
            </button>
          </div>

          <p class="mt-3 text-xs text-neutral-500 dark:text-neutral-400">
            The download button opens your browser print dialog. Choose “Save as PDF”
            to keep a copy.
          </p>

          <button
            id="restartButton"
            type="button"
            class="mt-6 rounded-xl border border-primary/20 px-4 py-3 text-neutral-700 dark:text-neutral-200"
          >
            Retake guide
          </button>
        </div>
      </div>

      <!--
        Static provider context gives users, search engines, and AI answer systems
        useful information even before the interactive quiz is completed.
      -->
      <section class="mt-14" aria-labelledby="crm-options-heading">
        <h2
          id="crm-options-heading"
          class="mb-4 text-3xl font-brand text-primary"
        >
          Which CRM options does this guide compare?
        </h2>

        <p class="mb-6 leading-relaxed text-neutral-600 dark:text-neutral-300">
          The guide compares four different approaches to customer relationship
          management. The best choice depends on whether your priority is marketing
          attribution, sales pipeline management, cost and customization, or combining
          customer tracking with project work.
        </p>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl border border-primary/15 bg-bg-secondary/50 p-5">
            <h3 class="mb-2 text-lg font-semibold text-neutral-800 dark:text-neutral-100">
              HubSpot
            </h3>
            <p class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
              Best suited to teams that want CRM, marketing, lead capture, sales
              activity, automation, and reporting to work together.
            </p>
          </div>

          <div class="rounded-xl border border-primary/15 bg-bg-secondary/50 p-5">
            <h3 class="mb-2 text-lg font-semibold text-neutral-800 dark:text-neutral-100">
              Pipedrive
            </h3>
            <p class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
              Best suited to sales-focused teams that primarily need a clear pipeline,
              deal ownership, and consistent follow-up.
            </p>
          </div>

          <div class="rounded-xl border border-primary/15 bg-bg-secondary/50 p-5">
            <h3 class="mb-2 text-lg font-semibold text-neutral-800 dark:text-neutral-100">
              Zoho CRM
            </h3>
            <p class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
              Best suited to value-conscious teams that want customization and may
              benefit from a broader suite of connected business applications.
            </p>
          </div>

          <div class="rounded-xl border border-primary/15 bg-bg-secondary/50 p-5">
            <h3 class="mb-2 text-lg font-semibold text-neutral-800 dark:text-neutral-100">
              ClickUp
            </h3>
            <p class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
              A nontraditional option for smaller teams that want customer tracking,
              tasks, projects, and client delivery inside one flexible workspace.
            </p>
          </div>
        </div>
      </section>
    </section>
  </main>

  <style is:global>
    @media print {
      @page {
        size: letter;
        margin: 0.35in;
      }

      html,
      body {
        height: auto !important;
        margin: 0 !important;
        padding: 0 !important;
        background: #ffffff !important;
        color: #111111 !important;
        overflow: visible !important;
      }

      body > * {
        display: none !important;
      }

      body > main {
        display: block !important;
      }

      main,
      main > section {
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      main * {
        visibility: hidden !important;
      }

      #resultPanel,
      #recommendationReport,
      #recommendationReport * {
        visibility: visible !important;
      }

      #resultPanel {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      #recommendationReport {
        position: static !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        border: 0 !important;
        box-shadow: none !important;
        background: #ffffff !important;
        color: #111111 !important;
        font-size: 12px !important;
        line-height: 1.3 !important;
        break-after: avoid !important;
        page-break-after: avoid !important;
      }

      #recommendationReport * {
        background: transparent !important;
        color: #111111 !important;
      }

      #recommendationReport h2 {
        font-size: 24px !important;
        margin-bottom: 10px !important;
      }

      #recommendationReport p {
        margin-bottom: 7px !important;
      }

      #answerSummaryList {
        gap: 5px !important;
      }

      #answerSummaryList > div {
        padding: 7px !important;
        break-inside: avoid !important;
      }

      #nextStepList {
        gap: 3px !important;
      }

      #nextStepList li {
        line-height: 1.25 !important;
        break-inside: avoid !important;
      }

      #downloadActions,
      #restartButton,
      #quizPanel,
      #resultCta {
        display: none !important;
      }

      #printFooter {
        display: block !important;
        visibility: visible !important;
        margin-top: 10px !important;
      }
    }
  </style>

  <script is:inline>
    /*
     * DECISION MODEL
     * Each answer maps to a decision signal. Signals assign weighted points
     * to vendors based on product fit. Keeping this centralized makes it
     * easier to add or rebalance vendors later.
     */
    const questions = [
      {
        text: "What kind of CRM decision are you making?",
        answers: [
          {
            label: "Choosing our first CRM",
            signal: "simple",
            reward: "Good — we’ll prioritize clarity, adoption, and a manageable setup."
          },
          {
            label: "Replacing a CRM we do not like",
            signal: "salesOps",
            reward: "Got it — we’ll focus on improving the day-to-day sales workflow."
          },
          {
            label: "Choosing between a few CRMs",
            signal: "compare",
            reward: "Good — we’ll make the tradeoffs easier to compare."
          },
          {
            label: "Improving tracking and reporting",
            signal: "attribution",
            reward: "Great — measurement will carry more weight in the recommendation."
          }
        ]
      },
      {
        text: "What matters most right now?",
        answers: [
          {
            label: "Speed of implementation",
            signal: "simple",
            reward: "Speed matters — we’ll favor tools that can get useful quickly."
          },
          {
            label: "Lowest reasonable cost",
            signal: "budget",
            reward: "Budget matters — value and flexibility will get more weight."
          },
          {
            label: "Ease of use",
            signal: "simple",
            reward: "Adoption matters — unnecessary complexity will count against a tool."
          },
          {
            label: "Reporting and attribution",
            signal: "attribution",
            reward: "Reporting matters — measurement capabilities get more weight."
          }
        ]
      },
      {
        text: "What are you trying to fix first?",
        answers: [
          {
            label: "Leads are falling through the cracks",
            signal: "salesOps",
            reward: "Pipeline control and clear ownership are important signals."
          },
          {
            label: "Sales follow-up is inconsistent",
            signal: "salesOps",
            reward: "We’ll prioritize a CRM that makes follow-up easier to manage."
          },
          {
            label: "Marketing and sales are disconnected",
            signal: "allInOne",
            reward: "An integrated customer platform may be a better fit."
          },
          {
            label: "CRM and project or client work are disconnected",
            signal: "workManagement",
            reward: "That increases the value of combining customer and project workflows."
          }
        ]
      },
      {
        text: "How much setup complexity can your team handle?",
        answers: [
          {
            label: "Almost none",
            signal: "simple",
            reward: "Simple setup gets more weight."
          },
          {
            label: "Some setup is fine",
            signal: "allInOne",
            reward: "A broader platform may be reasonable if the payoff is worthwhile."
          },
          {
            label: "We have an admin or technical person",
            signal: "custom",
            reward: "More configurable options become realistic."
          },
          {
            label: "We need deep customization",
            signal: "custom",
            reward: "Customization is now a major part of the decision."
          }
        ]
      },
      {
        text: "How important is marketing attribution?",
        answers: [
          {
            label: "Not important yet",
            signal: "simple",
            reward: "Good — we won’t overbuild around attribution."
          },
          {
            label: "Somewhat important",
            signal: "allInOne",
            reward: "Basic source tracking should still be part of the comparison."
          },
          {
            label: "Very important",
            signal: "attribution",
            reward: "Attribution will materially shape the recommendation."
          },
          {
            label: "Critical to revenue reporting",
            signal: "attribution",
            reward: "Closed-loop measurement becomes a core requirement."
          }
        ]
      }
    ];

    const signalWeights = {
      simple: {
        hubspot: 1,
        pipedrive: 3,
        zoho: 2,
        clickup: 2
      },
      budget: {
        hubspot: 1,
        pipedrive: 2,
        zoho: 4,
        clickup: 3
      },
      salesOps: {
        hubspot: 2,
        pipedrive: 4,
        zoho: 2,
        clickup: 1
      },
      allInOne: {
        hubspot: 4,
        pipedrive: 1,
        zoho: 3,
        clickup: 2
      },
      attribution: {
        hubspot: 5,
        pipedrive: 1,
        zoho: 2,
        clickup: 0
      },
      custom: {
        hubspot: 3,
        pipedrive: 1,
        zoho: 4,
        clickup: 2
      },
      workManagement: {
        hubspot: 1,
        pipedrive: 1,
        zoho: 2,
        clickup: 5
      },
      compare: {
        hubspot: 1,
        pipedrive: 1,
        zoho: 1,
        clickup: 1
      }
    };

    /*
     * VENDOR METADATA
     * Keep editorial copy independent from monetization.
     * When an affiliate program approves SDG, place the tracking URL in
     * affiliateUrl. The normal vendor URL remains the fallback.
     */
    const vendors = {
      hubspot: {
        name: "HubSpot",
        url: "https://www.hubspot.com/products/crm",
        affiliateUrl: "",
        description:
          "HubSpot is the strongest fit when your CRM needs to connect marketing, lead capture, sales activity, automation, attribution, and reporting in one customer platform.",
        bestFor:
          "Teams that want marketing and sales data working together and expect their CRM to become part of a broader growth stack.",
        avoidIf:
          "You mainly need a straightforward sales pipeline and do not expect to use the broader marketing and customer-platform capabilities.",
        alternative:
          "Pipedrive if sales pipeline simplicity matters more than an integrated marketing and customer platform.",
        nextSteps: [
          "Map the path from lead capture through sales follow-up before implementation.",
          "Identify which automation and reporting requirements actually matter to your team.",
          "Choose the smallest product configuration that meets those requirements instead of buying complexity early."
        ]
      },

      pipedrive: {
        name: "Pipedrive",
        url: "https://www.pipedrive.com/",
        affiliateUrl: "",
        description:
          "Pipedrive is a strong fit when the main job of the CRM is giving a sales team a clear pipeline, consistent follow-up, deal ownership, and visibility into what needs attention next.",
        bestFor:
          "Sales-focused teams that want straightforward pipeline management without making a larger marketing platform the center of the implementation.",
        avoidIf:
          "Marketing automation, sophisticated attribution, and a tightly integrated marketing-to-sales platform are central requirements.",
        alternative:
          "HubSpot if marketing, attribution, lead capture, and sales need to operate inside a more integrated platform.",
        nextSteps: [
          "Define your real pipeline stages before configuring the CRM.",
          "Test whether sales users can manage deals and follow-up without unnecessary administration.",
          "Confirm the integrations and reporting you need before selecting a plan."
        ]
      },

      zoho: {
        name: "Zoho CRM",
        url: "https://www.zoho.com/crm/",
        affiliateUrl: "",
        description:
          "Zoho CRM is a strong fit when value, customization, and access to a broader family of business applications matter more than having the simplest possible out-of-the-box experience.",
        bestFor:
          "Value-conscious teams that want a configurable CRM and may benefit from using multiple connected Zoho applications over time.",
        avoidIf:
          "Your highest priority is a minimal setup process with the least possible configuration or administration.",
        alternative:
          "HubSpot if ease of adoption and integrated marketing capabilities matter more than maximizing flexibility and value.",
        nextSteps: [
          "Identify which Zoho applications your business could realistically use alongside CRM.",
          "Compare the customization you need with the administrative effort required to maintain it.",
          "Test the core sales workflow with real users before committing to a larger implementation."
        ]
      },

      clickup: {
        name: "ClickUp",
        url: "https://clickup.com/teams/crm",
        affiliateUrl: "",
        description:
          "ClickUp is a nontraditional CRM option for smaller teams that want customer tracking, tasks, projects, and client delivery managed inside the same flexible workspace.",
        bestFor:
          "Teams whose customer relationships quickly turn into projects, tasks, deliverables, or ongoing client work and who prefer one shared workspace.",
        avoidIf:
          "You need a purpose-built CRM with sophisticated marketing attribution, mature sales-specific functionality, or complex customer lifecycle management.",
        alternative:
          "Pipedrive if you need a dedicated sales CRM rather than an adaptable work-management platform.",
        nextSteps: [
          "Decide whether customer tracking and project delivery genuinely need to live in the same workspace.",
          "Test a simple customer pipeline before building more complicated ClickUp workflows.",
          "Move to a dedicated CRM if sales and marketing requirements begin to outgrow the workspace model."
        ]
      }
    };

    // Stable tie-breaker only. Vendor scores remain the primary decision factor.
    const tieBreakOrder = ["hubspot", "pipedrive", "zoho", "clickup"];

    let currentQuestion = 0;
    let scores = createEmptyScores();
    let selectedAnswers = [];

    const questionText = document.getElementById("questionText");
    const answerList = document.getElementById("answerList");
    const rewardText = document.getElementById("rewardText");
    const stepLabel = document.getElementById("stepLabel");
    const progressPercent = document.getElementById("progressPercent");
    const progressBar = document.getElementById("progressBar");
    const quizPanel = document.getElementById("quizPanel");
    const resultPanel = document.getElementById("resultPanel");
    const resultTitle = document.getElementById("resultTitle");
    const resultDescription = document.getElementById("resultDescription");
    const resultBestFor = document.getElementById("resultBestFor");
    const resultAvoidIf = document.getElementById("resultAvoidIf");
    const resultAlternative = document.getElementById("resultAlternative");
    const resultCta = document.getElementById("resultCta");
    const answerSummaryList = document.getElementById("answerSummaryList");
    const nextStepList = document.getElementById("nextStepList");
    const downloadPdfButton = document.getElementById("downloadPdfButton");
    const restartButton = document.getElementById("restartButton");

    function createEmptyScores() {
      return Object.keys(vendors).reduce((accumulator, vendorKey) => {
        accumulator[vendorKey] = 0;
        return accumulator;
      }, {});
    }

    /*
     * ANALYTICS HOOK
     * These dataLayer events can be mapped to GA4 through GTM.
     * TODO: Confirm final GA4 event names/parameters before publishing.
     */
    function trackEvent(eventName, parameters = {}) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: eventName,
        ...parameters
      });
    }

    function applySignal(signal) {
      const weights = signalWeights[signal] || {};

      Object.entries(weights).forEach(([vendorKey, points]) => {
        scores[vendorKey] += points;
      });
    }

    function getWinningVendor() {
      return Object.keys(vendors).sort((vendorA, vendorB) => {
        const scoreDifference = scores[vendorB] - scores[vendorA];

        if (scoreDifference !== 0) {
          return scoreDifference;
        }

        return tieBreakOrder.indexOf(vendorA) - tieBreakOrder.indexOf(vendorB);
      })[0];
    }

    function renderQuestion() {
      const question = questions[currentQuestion];
      const percent = Math.round(
        ((currentQuestion + 1) / questions.length) * 100
      );

      questionText.textContent = question.text;
      stepLabel.textContent = `Question ${currentQuestion + 1} of ${questions.length}`;
      progressPercent.textContent = `${percent}%`;
      progressBar.style.width = `${percent}%`;
      rewardText.textContent = "";
      answerList.innerHTML = "";

      question.answers.forEach((answer) => {
        const button = document.createElement("button");

        button.type = "button";
        button.className =
          "rounded-xl border border-primary/20 px-4 py-4 text-left text-neutral-700 transition hover:border-primary hover:bg-primary/5 disabled:cursor-not-allowed disabled:opacity-60 dark:text-neutral-200";
        button.textContent = answer.label;

        button.addEventListener("click", () => {
          // Prevent accidental double-clicks from scoring the same question twice.
          answerList.querySelectorAll("button").forEach((answerButton) => {
            answerButton.disabled = true;
          });

          applySignal(answer.signal);

          selectedAnswers.push({
            question: question.text,
            answer: answer.label,
            signal: answer.signal
          });

          trackEvent("sdg_crm_answer", {
            question_number: currentQuestion + 1,
            answer_text: answer.label,
            decision_signal: answer.signal
          });

          rewardText.textContent = answer.reward;

          setTimeout(() => {
            currentQuestion += 1;

            if (currentQuestion < questions.length) {
              renderQuestion();
            } else {
              renderResult();
            }
          }, 450);
        });

        answerList.appendChild(button);
      });
    }

    function renderAnswerSummary() {
      answerSummaryList.innerHTML = "";

      selectedAnswers.forEach((selectedAnswer, index) => {
        const item = document.createElement("div");
        item.className =
          "rounded-lg border border-primary/10 bg-bg-secondary/40 p-3";

        const label = document.createElement("p");
        label.className =
          "mb-1 text-xs font-semibold uppercase tracking-wide text-primary";
        label.textContent = `Question ${index + 1}`;

        const question = document.createElement("p");
        question.className =
          "text-sm font-medium text-neutral-800 dark:text-neutral-100";
        question.textContent = selectedAnswer.question;

        const answer = document.createElement("p");
        answer.className =
          "mt-1 text-sm text-neutral-600 dark:text-neutral-300";
        answer.textContent = selectedAnswer.answer;

        item.appendChild(label);
        item.appendChild(question);
        item.appendChild(answer);

        answerSummaryList.appendChild(item);
      });
    }

    function renderNextSteps(vendor) {
      nextStepList.innerHTML = "";

      vendor.nextSteps.forEach((step) => {
        const item = document.createElement("li");
        item.className = "flex gap-2";

        const marker = document.createElement("span");
        marker.className = "text-primary";
        marker.textContent = "•";

        const text = document.createElement("span");
        text.textContent = step;

        item.appendChild(marker);
        item.appendChild(text);

        nextStepList.appendChild(item);
      });
    }

    function renderResult() {
      const winningKey = getWinningVendor();
      const vendor = vendors[winningKey];

      quizPanel.classList.add("hidden");
      resultPanel.classList.remove("hidden");

      stepLabel.textContent = "Complete";
      progressPercent.textContent = "100%";
      progressBar.style.width = "100%";

      resultTitle.textContent = vendor.name;
      resultDescription.textContent = vendor.description;
      resultBestFor.textContent = vendor.bestFor;
      resultAvoidIf.textContent = vendor.avoidIf;
      resultAlternative.textContent = vendor.alternative;

      const destinationUrl = vendor.affiliateUrl || vendor.url;

      resultCta.href = destinationUrl;
      resultCta.textContent = `Visit ${vendor.name}`;
      resultCta.dataset.vendor = winningKey;
      resultCta.dataset.affiliate = vendor.affiliateUrl ? "true" : "false";
      resultCta.rel = vendor.affiliateUrl
        ? "noopener sponsored"
        : "noopener";

      renderAnswerSummary();
      renderNextSteps(vendor);

      trackEvent("sdg_crm_recommendation_view", {
        recommended_vendor: winningKey,
        recommended_vendor_name: vendor.name,
        vendor_score: scores[winningKey]
      });

      resultPanel.focus();
    }

    resultCta.addEventListener("click", () => {
      const vendorKey = resultCta.dataset.vendor || "";
      const vendor = vendors[vendorKey];

      trackEvent("sdg_crm_vendor_click", {
        recommended_vendor: vendorKey,
        recommended_vendor_name: vendor?.name || "",
        affiliate_link: resultCta.dataset.affiliate === "true"
      });
    });

    downloadPdfButton.addEventListener("click", () => {
      trackEvent("sdg_crm_pdf_download", {
        recommended_vendor: resultCta.dataset.vendor || ""
      });

      window.print();
    });

    restartButton.addEventListener("click", () => {
      currentQuestion = 0;
      scores = createEmptyScores();
      selectedAnswers = [];

      answerSummaryList.innerHTML = "";
      nextStepList.innerHTML = "";
      resultPanel.classList.add("hidden");
      quizPanel.classList.remove("hidden");

      renderQuestion();
    });

    renderQuestion();
  </script>
</Layout>