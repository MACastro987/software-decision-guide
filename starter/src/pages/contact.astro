---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Contact | Software Decision Guide"
  description="Contact Software Decision Guide about CRM selection, software decision guides, and measurement implementation."
>
  <main class="site-container py-28">
    <section class="mx-auto max-w-3xl">
      <p class="mb-4 text-sm font-semibold uppercase tracking-wide text-primary">
        Contact
      </p>

      <h1 class="mb-5 text-5xl font-brand text-primary">
        Contact Software Decision Guide
      </h1>

      <p class="mb-10 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-300">
        Have a question about CRM selection, software decision guides, or measurement implementation? Send a note below.
      </p>

      <div class="hubspot-form-card rounded-2xl border border-primary/15 bg-bg-secondary/70 p-6 shadow-sm">
        <script is:inline src="https://js-na2.hsforms.net/forms/embed/247021690.js" defer></script>
        <div
          class="hs-form-frame"
          data-region="na2"
          data-form-id="2888c2c9-1dfd-467b-a742-991b5c4c6616"
          data-portal-id="247021690"
        ></div>
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  .dark .hubspot-form-card,
  .dark .hubspot-form-card * {
    color: #f9fafb;
  }

  .dark .hubspot-form-card label,
  .dark .hubspot-form-card p,
  .dark .hubspot-form-card span,
  .dark .hubspot-form-card h1,
  .dark .hubspot-form-card h2,
  .dark .hubspot-form-card h3 {
    color: #f9fafb;
  }

  .dark .hubspot-form-card input,
  .dark .hubspot-form-card textarea,
  .dark .hubspot-form-card select {
    color: #111827;
    background-color: #f9fafb;
  }

  .dark .hubspot-form-card a {
    color: #93c5fd;
  }
</style>