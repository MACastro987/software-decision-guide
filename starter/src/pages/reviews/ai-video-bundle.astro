---
import Layout from "@/layouts/Layout.astro";

const affiliateUrl =
  "https://59addfoc26r6ck8-vqg37oapcg.hop.clickbank.net/?cbpage=v&traffic_source=sdg&traffic_type=referral&campaign=ai-video-bundle-v1";

const faqs = [
  {
    question: "What is AI Video Bundle?",
    answer:
      "AI Video Bundle is a digital video-creation offer aimed at marketers and creators who want to produce AI-assisted video content more efficiently.",
  },
  {
    question: "Who is AI Video Bundle best for?",
    answer:
      "It is most relevant to marketers, creators, agencies, and businesses that regularly need advertising or social-media video assets.",
  },
  {
    question: "Is AI Video Bundle digitally delivered?",
    answer:
      "Yes. It is a digital offer, so fulfillment does not depend on shipping or local service availability.",
  },
  {
    question: "Should I see the full product presentation before buying?",
    answer:
      "Yes. The vendor's video presentation explains the current offer, features, pricing, and any included bonuses in more detail.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<Layout
  title="AI Video Bundle Review 2026 | Software Decision Guide"
  description="See who AI Video Bundle is designed for, where it may fit into a content workflow, and whether the AI video offer is worth exploring."
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  />

  <main class="site-container py-24 md:py-28">
    <article class="mx-auto max-w-4xl">

      <section class="mb-16 text-center">
        <p class="mb-4 text-sm font-semibold uppercase tracking-wide text-primary">
          Software Decision Guide Review
        </p>

        <h1 class="mx-auto mb-6 max-w-3xl text-4xl font-brand text-primary md:text-6xl">
          Create More Video Assets Without Building Everything From Scratch
        </h1>

        <p class="mx-auto mb-8 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-300">
          AI Video Bundle is designed for marketers, creators, and businesses
          looking for a faster AI-assisted approach to producing video content
          for advertising and online campaigns.
        </p>

        <a
          href={affiliateUrl}
          target="_blank"
          rel="sponsored nofollow noopener"
          data-affiliate="ai-video-bundle"
          class="inline-flex rounded-xl bg-primary px-7 py-4 text-lg font-semibold text-white transition hover:opacity-90"
        >
          Watch the AI Video Bundle Presentation
        </a>

        <p class="mt-4 text-xs text-neutral-500 dark:text-neutral-400">
          Affiliate disclosure: Software Decision Guide may earn a commission
          if you purchase through this link, at no additional cost to you.
        </p>
      </section>

      <section class="mb-14 rounded-3xl border border-primary/15 bg-bg-secondary/70 p-7 shadow-sm md:p-9">
        <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-primary">
          Quick verdict
        </p>

        <h2 class="mb-4 text-3xl font-semibold text-neutral-900 dark:text-white">
          Most interesting for people who constantly need new video creative
        </h2>

        <p class="leading-relaxed text-neutral-600 dark:text-neutral-300">
          The strongest use case is not simply “AI video.” It is reducing the
          time and effort required to create fresh video assets for campaigns,
          social content, offers, and testing. That makes it most relevant to
          marketers and creators with an ongoing demand for new creative.
        </p>
      </section>

      <section class="mb-14">
        <h2 class="mb-7 text-3xl font-semibold text-primary">
          Who should consider it?
        </h2>

        <div class="grid gap-5 md:grid-cols-2">
          {[
            ["Performance marketers", "Create additional video concepts and creative variations for campaign testing."],
            ["Creators", "Produce more short-form or promotional content without starting every asset from zero."],
            ["Agencies", "Increase creative output across multiple clients and campaigns."],
            ["Small businesses", "Produce promotional video without maintaining a large internal production team."],
          ].map(([title, text]) => (
            <div class="rounded-2xl border border-primary/15 bg-bg-secondary/70 p-6 shadow-sm">
              <h3 class="mb-2 text-xl font-semibold text-primary">{title}</h3>
              <p class="leading-relaxed text-neutral-600 dark:text-neutral-300">
                {text}
              </p>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-14">
        <h2 class="mb-7 text-3xl font-semibold text-primary">
          Where the value could come from
        </h2>

        <div class="grid gap-5 md:grid-cols-3">
          {[
            ["Creative velocity", "Generate more potential video concepts without expanding production effort at the same rate."],
            ["Campaign testing", "More assets can create more opportunities to test hooks, angles, and creative approaches."],
            ["Digital workflow", "The offer is digitally delivered and can support users regardless of local geography."],
          ].map(([title, text]) => (
            <div class="rounded-2xl border border-primary/15 bg-bg-secondary/70 p-6 shadow-sm">
              <h3 class="mb-2 text-lg font-semibold text-primary">{title}</h3>
              <p class="leading-relaxed text-neutral-600 dark:text-neutral-300">
                {text}
              </p>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-14 grid gap-5 md:grid-cols-2">
        <div class="rounded-2xl border border-primary/15 bg-bg-secondary/70 p-7 shadow-sm">
          <h2 class="mb-5 text-2xl font-semibold text-primary">Potential fit if...</h2>

          <ul class="space-y-3 text-neutral-600 dark:text-neutral-300">
            <li>✓ You regularly need new video creative</li>
            <li>✓ You run paid or social campaigns</li>
            <li>✓ Creative production is a bottleneck</li>
            <li>✓ You want to test more hooks and concepts</li>
          </ul>
        </div>

        <div class="rounded-2xl border border-primary/15 bg-bg-secondary/70 p-7 shadow-sm">
          <h2 class="mb-5 text-2xl font-semibold text-primary">Probably not if...</h2>

          <ul class="space-y-3 text-neutral-600 dark:text-neutral-300">
            <li>– You rarely produce video</li>
            <li>– You need high-end custom cinematography</li>
            <li>– Your creative workflow already has excess capacity</li>
            <li>– You are looking primarily for long-form editing software</li>
          </ul>
        </div>
      </section>

      <section class="mb-14 rounded-3xl border border-primary/20 bg-bg-secondary/70 p-8 text-center shadow-sm md:p-10">
        <h2 class="mb-4 text-3xl font-semibold text-primary">
          See the current offer before deciding
        </h2>

        <p class="mx-auto mb-7 max-w-xl leading-relaxed text-neutral-600 dark:text-neutral-300">
          The vendor presentation contains the current product details,
          pricing, demonstrations, and offer structure.
        </p>

        <a
          href={affiliateUrl}
          target="_blank"
          rel="sponsored nofollow noopener"
          data-affiliate="ai-video-bundle"
          class="inline-flex rounded-xl bg-primary px-7 py-4 text-lg font-semibold text-white transition hover:opacity-90"
        >
          Watch the Presentation
        </a>
      </section>

      <section>
        <h2 class="mb-6 text-3xl font-semibold text-primary">
          Frequently asked questions
        </h2>

        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="rounded-2xl border border-primary/15 bg-bg-secondary/70 p-6 shadow-sm">
              <h3 class="mb-2 text-lg font-semibold text-primary">
                {faq.question}
              </h3>

              <p class="leading-relaxed text-neutral-600 dark:text-neutral-300">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <script is:inline>
    document.addEventListener("click", function (event) {
      const link = event.target.closest("a[data-affiliate]");
      if (!link) return;

      window.dataLayer = window.dataLayer || [];

      window.dataLayer.push({
        event: "affiliate_click",
        affiliate_name: link.dataset.affiliate,
        affiliate_url: link.href,
        page_location: window.location.href
      });
    });
  </script>
</Layout>